# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GITHUB_CLIENT_ID & GITHUB_CLIENT_SECRET: Optional for 1-click GitHub OAuth popup login.
# Create an OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# GITHUB_TOKEN: Optional GitHub Personal Access Token (with 'repo' and 'workflow' scopes)
# for instant 1-click repository creation and push from the server.
GITHUB_TOKEN=""
