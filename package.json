{
  "name": "knowledge-garden",
  "private": true,
  "version": "1.0.0",
  "description": "بستان المعرفة — Knowledge Garden Desktop Application",
  "author": "Knowledge Garden",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "desktop:exe": "vite build && npx --yes electron-builder --win --x64"
  },
  "build": {
    "appId": "com.knowledgegarden.desktop",
    "productName": "KnowledgeGarden",
    "electronVersion": "33.2.0",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/pwa-512x512.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/pwa-512x512.png",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.26",
    "@tiptap/extension-highlight": "^3.33.1",
    "@tiptap/extension-link": "^3.33.1",
    "@tiptap/extension-placeholder": "^3.33.1",
    "@tiptap/extension-text-style": "^3.33.1",
    "@tiptap/extension-underline": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@types/d3-force": "^3.0.10",
    "@types/dompurify": "^3.0.5",
    "@vitejs/plugin-react": "^6.1.1",
    "d3-force": "^3.0.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "dompurify": "^3.4.17",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "minisearch": "^7.2.0",
    "motion": "^12.23.24",
    "pixi.js": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
